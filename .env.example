# Discord bot token (Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=

# Target guild id (right-click server -> Copy Server ID)
GUILD_ID=

# Optional owner id, reserved for owner-only commands
OWNER_ID=

# Member role granted automatically on join
MEMBER_ROLE_ID=

# true = wipe and rebuild the server on every start, false = only register audit logs
BUILD_ON_START=false

# true = verbose debug logs
DEBUG=false

# true = skip the local single-instance lock (required on hosting platforms)
SKIP_LOCK=true
